# 這是範例檔——複製一份成 .env（同一個資料夾），填入真實值。
# .env 已加進 .gitignore，不會被 commit（見 specs/phase1.md 第 11 節）。
#
# 這份 .env.example 只是給人看的格式參考，不會被任何腳本讀取。

# Google Cloud Console 建立的 OAuth Client（網頁應用程式類型）
# 重新導向 URI 要設定為 http://localhost:53682
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 這一行不用手動填——跑過 scripts/setup-oauth（npm start）走完 OAuth 授權後會自動寫入/更新
GOOGLE_OAUTH_REFRESH_TOKEN=

# Google Cloud Console 建立的 PageSpeed Insights API Key
PAGESPEED_API_KEY=
